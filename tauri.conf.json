{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pixity",
  "version": "0.1.0",
  "identifier": "dev.pixity.desktop",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "https://pixity.dev",
        "title": "pixity.dev",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["pixity"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "pixity.dev",
    "longDescription": "The pixity.dev desktop, with native screen capture on macOS and Linux.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libpipewire-0.3-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "pipewire-libs"],
        "release": "1"
      }
    }
  },
  "plugins": {}
}
